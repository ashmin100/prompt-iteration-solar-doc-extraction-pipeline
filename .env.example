# Choose a backend by setting LLM_BACKEND to one of: ollama | groq | hf | openai_compat
LLM_BACKEND=ollama

# --- Ollama (default, local, no key required) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# --- Groq (free tier, open-weight models, OpenAI-compatible) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Hugging Face Inference API (free tier) ---
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Generic OpenAI-compatible (Together, OpenRouter, Fireworks, vLLM, private gateways, etc.) ---
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
